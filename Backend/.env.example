# Local development environment configuration
# Copy this file to .env in the Backend directory and fill in your API keys

# API Keys
GROQ_API_KEY=your_groq_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here
SMALLEST_API_KEY=your_smallest_api_key_here
CARTESIA_API_KEY=your_cartesia_api_key_here
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Model & Provider defaults
STT_PROVIDER=groq
TTS_PROVIDER=sarvam
STT_FALLBACK_ENABLED=true
STT_FALLBACK_ON_EMPTY=true
TTS_DISABLE_AGENT_OVERRIDES=false
TTS_FALLBACK_ENABLED=true
TTS_FALLBACK_PROVIDER=cartesia

# Feature Flags
FEATURE_AUTH_ENFORCE_BACKEND=false
FEATURE_CAMPAIGN_LIFECYCLE_MANAGEMENT=true
FEATURE_CAMPAIGN_WORKER_V2=true
FEATURE_CRM_SYNC_ENABLED=true
FEATURE_FLOW_V2_LIVE=true
FEATURE_FLOW_V2_SHADOW=true
FEATURE_FLOW_VISUALIZATION=true
FEATURE_MEMORY_RAG_ENABLED=true
FEATURE_SCRAPE_GENERATE_SCRIPT=true
FEATURE_SCRAPE_WORKER_V1=true
FEATURE_TELEPHONY_TENANT_NUMBERS=true
FEATURE_TENANT_ENFORCEMENT_READINESS=true
